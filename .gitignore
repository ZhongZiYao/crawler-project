# ============================================================
# 爬虫项目 .gitignore
# 只推送代码、说明文件、规范文件；排除下载的公告文件和运行时产物
# ============================================================

# ---------- 虚拟环境 ----------
.venv/
.venv-*/
*/.venv/
*/.venv-*/

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo

# ---------- 下载目录（各项目存放公告文件的目录）----------
download_files/
downloaded_files/
downloaded_pdfs/
download_pdf/
青银理财pdf/

# ---------- 分类结果 / 旧分类产物 ----------
分类结果/
光大文件分类/
光大银行_发行公告_产品说明书/

# ---------- 压缩文件 ----------
*.7z
*.zip
*.rar

# ---------- 下载的公告文件 ----------
*.pdf

# ---------- 运行时日志 / 临时文件 ----------
*.log
.tmp/
*/.tmp/
~$*
xml

# ---------- 下载日志 CSV ----------
*.csv

# ---------- 根目录运行日志 txt ----------
run_all_log.txt
run_all_err.txt
run_stdout.txt
run_stderr.txt

# ---------- 爬虫运行状态 ----------
state/
*/state/
*.db
*.db-journal

# ---------- 浏览器用户数据 / 指标 ----------
edge_userdata/
*.pma

# ---------- IDE 配置 ----------
.idea/

# ---------- 错误日志 ----------
*.err

# ---------- 环境配置（可能含密钥）----------
.env
